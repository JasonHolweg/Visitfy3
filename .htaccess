# ══════════════════════════════════════════════════════════════
#  Visitfy3 – Apache-Konfiguration, Weiterleitungen & Sicherheit
#  Seitenliste/URLs: partials/routes.php (muss zum Block „Saubere URLs“ passen)
# ══════════════════════════════════════════════════════════════

Options -Indexes
DirectoryIndex index.php
AddDefaultCharset UTF-8
ErrorDocument 404 /404.php

# ── Upload-Limits fürs Admin-Media-Tool (mod_php; Server-Standard ist nur 2M) ──
<IfModule php_module>
  php_value upload_max_filesize 12M
  php_value post_max_size 14M
</IfModule>

# ── Zugriff auf interne Dateien sperren ──────────────────────
<FilesMatch "(\.env|\.git|\.gitignore|deploy\.env|bootstrap\.php|\.sh|\.md|\.example|\.bak|\.jsonl|\.sql)$">
  Require all denied
</FilesMatch>
<FilesMatch "^config\..+\.php$">
  Require all denied
</FilesMatch>
<Files "inquiries.json">
  Require all denied
</Files>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Ziel für Weiterleitungen: live immer https://visitfy.de, lokal der aktuelle Host
  RewriteRule ^ - [E=CANON:%{REQUEST_SCHEME}://%{HTTP_HOST}]
  RewriteCond %{HTTP_HOST} ^(www\.)?visitfy\.de$ [NC]
  RewriteRule ^ - [E=CANON:https://visitfy.de]

  # ── 1) Interne Ordner nicht ausliefern ───────────────────────
  RewriteRule ^(partials|tools|ops|assets/data|\.github|\.git)(/|$) - [R=404,L]

  # ── 2) Alte Adressen → saubere URLs (ein einziger 301-Sprung) ─
  # Startseite nur unter /
  RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
  RewriteCond %{THE_REQUEST} \s/index\.php[\s?] [NC]
  RewriteCond %{QUERY_STRING} !(^|&)page= [NC]
  RewriteRule ^index\.php$ %{ENV:CANON}/ [R=301,L]

  # Alter Router /?page=… bzw. /index.php?page=…
  RewriteCond %{QUERY_STRING} (^|&)page=partner(&|$) [NC]
  RewriteRule ^(index\.php)?$ %{ENV:CANON}/partner-werden [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (^|&)page=kontakt(&|$) [NC]
  RewriteRule ^(index\.php)?$ %{ENV:CANON}/kontakt [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (^|&)page=faq(&|$) [NC]
  RewriteRule ^(index\.php)?$ %{ENV:CANON}/faq [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (^|&)page=about(&|$) [NC]
  RewriteRule ^(index\.php)?$ %{ENV:CANON}/ueber-uns [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (^|&)page=impressum(&|$) [NC]
  RewriteRule ^(index\.php)?$ %{ENV:CANON}/impressum [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (^|&)page=datenschutz(&|$) [NC]
  RewriteRule ^(index\.php)?$ %{ENV:CANON}/datenschutz [R=301,L,QSD]

  # /pages/*.php (nur GET/HEAD – Formulare posten weiter an die Datei)
  RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
  RewriteCond %{THE_REQUEST} \s/pages/partner\.php[\s?] [NC]
  RewriteRule ^pages/partner\.php$ %{ENV:CANON}/partner-werden [R=301,L,QSD]
  RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
  RewriteCond %{THE_REQUEST} \s/pages/kontakt\.php[\s?] [NC]
  RewriteRule ^pages/kontakt\.php$ %{ENV:CANON}/kontakt [R=301,L,QSD]
  RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
  RewriteCond %{THE_REQUEST} \s/pages/faq\.php[\s?] [NC]
  RewriteRule ^pages/faq\.php$ %{ENV:CANON}/faq [R=301,L,QSD]
  RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
  RewriteCond %{THE_REQUEST} \s/pages/about\.php[\s?] [NC]
  RewriteRule ^pages/about\.php$ %{ENV:CANON}/ueber-uns [R=301,L,QSD]
  RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
  RewriteCond %{THE_REQUEST} \s/pages/impressum\.php[\s?] [NC]
  RewriteRule ^pages/impressum\.php$ %{ENV:CANON}/impressum [R=301,L,QSD]
  RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
  RewriteCond %{THE_REQUEST} \s/pages/datenschutz\.php[\s?] [NC]
  RewriteRule ^pages/datenschutz\.php$ %{ENV:CANON}/datenschutz [R=301,L,QSD]

  # Ältere Adressen aus früheren Website-Versionen
  RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
  RewriteRule ^sitemap\.xml\.php$ %{ENV:CANON}/sitemap.xml [R=301,L,NC]
  RewriteRule ^(de|en)/?$ %{ENV:CANON}/ [R=301,L,NC]
  RewriteRule ^(partner|partnerschaft)/?$ %{ENV:CANON}/partner-werden [R=301,L,NC]
  RewriteRule ^(about|ueber|uber-uns)/?$ %{ENV:CANON}/ueber-uns [R=301,L,NC]
  RewriteRule ^(contact|anfrage)/?$ %{ENV:CANON}/kontakt [R=301,L,NC]

  # Schrägstrich am Ende entfernen (außer bei echten Ordnern)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ %{ENV:CANON}/$1 [R=301,L]

  # ── 3) Eine Adresse: https://visitfy.de (ohne www) ───────────
  RewriteCond %{HTTP_HOST} ^www\.visitfy\.de$ [NC]
  RewriteRule ^ https://visitfy.de%{REQUEST_URI} [R=301,L,NE]

  RewriteCond %{HTTP_HOST} ^visitfy\.de$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://visitfy.de%{REQUEST_URI} [R=301,L,NE]

  # ── 4) Saubere URLs (intern auf die PHP-Datei) ───────────────
  RewriteRule ^partner-werden$ pages/partner.php [L]
  RewriteRule ^kontakt$ pages/kontakt.php [L]
  RewriteRule ^faq$ pages/faq.php [L]
  RewriteRule ^ueber-uns$ pages/about.php [L]
  RewriteRule ^impressum$ pages/impressum.php [L]
  RewriteRule ^datenschutz$ pages/datenschutz.php [L]

  # ── 5) Technische Endpunkte ──────────────────────────────────
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
  RewriteRule ^llms\.txt$ llms.php [L]
</IfModule>

# ── Sicherheits-Header ───────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), encrypted-media=()"
  Header unset X-Powered-By
  Header always unset X-Powered-By
</IfModule>

# ── PHP-Härtung (mod_php) ────────────────────────────────────
<IfModule mod_php.c>
  php_flag expose_php Off
</IfModule>

# ── Compression (Brotli falls verfügbar, sonst Gzip) ─────────
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS \
    text/html text/plain text/css text/xml text/javascript \
    application/javascript application/json application/ld+json \
    application/xml application/rss+xml application/atom+xml \
    image/svg+xml font/otf font/ttf application/font-woff application/font-woff2
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE \
    text/html text/plain text/css text/xml text/javascript \
    application/javascript application/json application/ld+json \
    application/xml application/rss+xml application/atom+xml \
    image/svg+xml font/otf font/ttf application/font-woff application/font-woff2
</IfModule>

# ── Browser-Caching / Expires ────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML: kurz, immer revalidieren
  ExpiresByType text/html "access plus 0 seconds"

  # CSS / JS (mit ?v=…-Cache-Buster aus filemtime())
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType text/javascript           "access plus 1 year"

  # Bilder & Icons
  ExpiresByType image/jpeg                "access plus 6 months"
  ExpiresByType image/png                 "access plus 6 months"
  ExpiresByType image/webp                "access plus 6 months"
  ExpiresByType image/avif                "access plus 6 months"
  ExpiresByType image/gif                 "access plus 6 months"
  ExpiresByType image/svg+xml             "access plus 6 months"
  ExpiresByType image/x-icon              "access plus 1 year"

  # Fonts
  ExpiresByType font/woff                 "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType application/font-woff     "access plus 1 year"
  ExpiresByType application/font-woff2    "access plus 1 year"

  # JSON / XML
  ExpiresByType application/json          "access plus 0 seconds"
  ExpiresByType application/ld+json       "access plus 0 seconds"
  ExpiresByType application/xml           "access plus 1 day"
  ExpiresByType text/xml                  "access plus 1 day"
</IfModule>

# ── Cache-Control via Headers (immutable für hashed assets) ──
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(jpe?g|png|gif|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=15552000"
  </FilesMatch>
  <FilesMatch "\.(woff2?|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ── Vary-Header für korrekte Cache-Keys ──────────────────────
<IfModule mod_headers.c>
  <FilesMatch "\.(html|php|css|js|json|svg|xml)$">
    Header append Vary "Accept-Encoding"
  </FilesMatch>
</IfModule>

# ── Korrekte MIME-Typen für SEO/GEO-Dateien ──────────────────
<IfModule mod_mime.c>
  AddType application/ld+json .jsonld
  AddType text/markdown        .md
  AddType text/plain           .txt
</IfModule>
